DEFINE SCHEMA

    RECORD TYPE CDMR (
        CD_entityNames   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_recordNames   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_relationships STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_BroadcastLink (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_label               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_label_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_notes               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset       ASSET,
        CD_session             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_url                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_url_ckAsset         ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Client (
        CD_contact                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_contact_ckAsset         ASSET,
        CD_defaultCurrency         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_defaultCurrency_ckAsset ASSET,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt             BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset     ASSET,
        CD_name                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset            ASSET,
        CD_notes                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset           ASSET,
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_FeeRevision (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_job                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_parentsJSON         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_parentsJSON_ckAsset ASSET,
        CD_valueJSON           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_valueJSON_ckAsset   ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Invoice (
        CD_client              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
