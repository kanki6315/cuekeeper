    RECORD TYPE CD_Job (
        CD_bookingStatus           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_bookingStatus_ckAsset   ASSET,
        CD_client                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_endDay                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_endDay_ckAsset          ASSET,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_event                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_location                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_location_ckAsset        ASSET,
        CD_moveReceipt             BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset     ASSET,
        CD_name                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset            ASSET,
        CD_notes                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset           ASSET,
        CD_project                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_series                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDay                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDay_ckAsset        ASSET,
        CD_timeZoneID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeZoneID_ckAsset      ASSET,
        CD_trackPlaceID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_trackPlaceID_ckAsset    ASSET,
        CD_workArrangement         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_workArrangement_ckAsset ASSET,
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PaymentRecord (
        CD_amount              INT64 QUERYABLE SORTABLE,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_currency            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_currency_ckAsset    ASSET,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_invoice             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_job                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_note                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset        ASSET,
        CD_receivedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_reversesID          STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkEvent (
        CD_endDay               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_endDay_ckAsset       ASSET,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_location             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_location_ckAsset     ASSET,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        CD_notes                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset        ASSET,
        CD_startDay             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDay_ckAsset     ASSET,
        CD_timeZoneID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeZoneID_ckAsset   ASSET,
        CD_title                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset        ASSET,
        CD_trackPlaceID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_trackPlaceID_ckAsset ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkProject (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkRole (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkSeries (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkSession (
        CD_callTime               TIMESTAMP QUERYABLE SORTABLE,
        CD_coverage               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_coverage_ckAsset       ASSET,
        CD_day                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_day_ckAsset            ASSET,
        CD_deletedAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_endTime                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_job                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt            BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset    ASSET,
        CD_name                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset           ASSET,
        CD_notes                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset          ASSET,
        CD_overridesRoles         INT64 QUERYABLE SORTABLE,
        CD_overridesSeries        INT64 QUERYABLE SORTABLE,
        CD_scheduleStatus         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scheduleStatus_ckAsset ASSET,
        CD_series                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startTime              TIMESTAMP QUERYABLE SORTABLE,
        CD_timeZoneID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timeZoneID_ckAsset     ASSET,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CuekeeperCalendarPublisher (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        ownerID         STRING QUERYABLE SEARCHABLE SORTABLE,
        ownerName       STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
